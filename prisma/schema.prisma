// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  // output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ! ENUMS

enum UserRole {
  SUPER_ADMIN
  UNIVERSITY_ADMIN
  COMPANY_ADMIN
  UNIVERSITY_SUPERVISOR
  COMPANY_TRAINER
  STUDENT
}

enum StudentApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum InternshipStatus {
  ACTIVE
  COMPLETED
  CLOSED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TrainingType {
  REMOTE
  ONSITE
  HYBRID
}

enum AttendanceStatus {
  CHECKED_IN
  CHECKED_OUT
  MARKED_PRESENT
  MARKED_ABSENT
}

enum EvaluationType {
  AI
  TRAINER
  SUPERVISOR
}

enum NotificationType {
  TASK
  ANNOUNCEMENT
  APPLICATION
  EVALUATION
  SYSTEM
}

enum DeviceType {
  IOS
  ANDROID
  WEB
}

enum StatusType {
  ONLINE
  OFFLINE
  AWAY
  BUSY
}

enum UniversityAction {
  CREATED
  UPDATED
  STATUS_CHANGED
  DEACTIVATED
  ACTIVATED
}

enum CompanyAction {
  CREATED
  UPDATED
  STATUS_CHANGED
  DEACTIVATED
  ACTIVATED
}

enum UserAction {
  LOGIN
  LOGOUT
  ONLINE
  OFFLINE
  AWAY
  BUSY
  PROFILE_UPDATED
}

// ! User Model

model User {
  id                Int                          @id @default(autoincrement())
  email             String                       @unique
  recoveryEmail     String?                      @unique
  password          String
  // fullName          String
  firstName         String
  lastName          String
  personalID        Int                          @unique
  phone             String?
  profileImage      String?
  role              UserRole
  universityId      Int?
  companyId         Int?
  isActive          Boolean                      @default(true)
  studentProfile    StudentProfile?
  trainerProfile    CompanyTrainerProfile?
  supervisorProfile UniversitySupervisorProfile?

  createdAt DateTime @default(now())

  notifications         Notification[]
  sentMessages          Message[]      @relation("sent")
  receivedMessages      Message[]      @relation("recv")
  evaluations           Evaluation[]   @relation("UserEvaluations")
  trainerInternships    Internship[]   @relation("TrainerInternship")
  supervisorInternships Internship[]   @relation("SupervisorInternship")
  sessions              Session[]

  university         University?         @relation(fields: [universityId], references: [id], onDelete: SetNull)
  company            Company?            @relation(fields: [companyId], references: [id], onDelete: SetNull)
  passwordResetCodes PasswordResetCode[]
  userActivityLogs   UserActivityLog[]
  userStatuses       UserStatus[]

  @@index([isActive])
  // to enable role filter
  @@index([role])
  @@index([role, isActive])
}

//! User Activity log model(tracker)

model UserActivityLog {
  id         Int        @id @default(autoincrement())
  userId     Int
  action     UserAction
  ipAddress  String?
  userAgent  String?
  deviceInfo String?
  createdAt  DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

//! User status model (for lastseen & online status)

model UserStatus {
  userId   Int        @id
  status   StatusType @default(OFFLINE)
  lastSeen DateTime   @default(now())
  updatedAt DateTime  @updatedAt 

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ! Session Model

model Session {
  id               String      @id @default(cuid())
  userId           Int
  refreshTokenHash String
  // deviceInfo       String?
  deviceType       DeviceType?
  ipAddress        String?
  userAgent        String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  expiresAt        DateTime
  revokedAt        DateTime?
  lastUsedAt       DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, revokedAt])
  @@map("sessions")
}

// ! code Model
model PasswordResetCode {
  id        Int       @id @default(autoincrement())
  userId    Int
  code      String
  jti       String?   @unique
  usedAt    DateTime?
  expiresAt DateTime
  used      Boolean   @default(false)
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([code])
}

// ! University Model

model University {
  id          Int      @id @default(autoincrement())
  name        String
  email       String?
  shortCode   String   @unique
  phone       String?
  location    String?
  description String?
  logo        String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())

  users       User[]
  internships Internship[]
  students    StudentProfile[]
  supervisors UniversitySupervisorProfile[]
  uditLogs    UniversityAuditLog[]
}

//! University log model(tracker)

model UniversityAuditLog {
  id           Int              @id @default(autoincrement())
  universityId Int
  action       UniversityAction
  performedBy  Int // userId
  oldValue     Json?
  newValue     Json?
  createdAt    DateTime         @default(now())

  university University @relation(fields: [universityId], references: [id], onDelete: Cascade)
}

// ! Company Model

model Company {
  id          Int     @id @default(autoincrement())
  name        String
  email       String?
  shortCode   String  @unique
  phone       String?
  location    String?
  description String?
  logo        String?
  isActive    Boolean @default(true)

  users         User[]
  internships   Internship[]
  trainers      CompanyTrainerProfile[]
  opportunities TrainingOpportunity[]
  auditLogs     CompanyAuditLog[]
}

//! Company log model(tracker)

model CompanyAuditLog {
  id          Int           @id @default(autoincrement())
  companyId   Int
  action      CompanyAction
  performedBy Int // userId
  oldValue    Json?
  newValue    Json?
  createdAt   DateTime      @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

// ! Student Profile Model

model StudentProfile {
  userId               Int                   @id
  universityId         Int
  studentNumber        BigInt
  major                String?
  academicYear         Int?
  gpa                  Float?
  cvUrl                String?
  verificationDocument String
  // approvalStatus       String?
  approvalStatus       StudentApprovalStatus @default(PENDING)
  approvedAt           DateTime?
  rejectionReason      String?
  skills               String?

  internships     InternshipStudent[]
  attendance      Attendance[]
  evaluations     Evaluation[]
  taskSubmissions TaskSubmission[]

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  university University @relation(fields: [universityId], references: [id], onDelete: Cascade)

  @@unique([studentNumber, universityId])
  @@index([studentNumber])
  // approval filtering
  @@index([approvalStatus])
  // university-based queries
  @@index([universityId])
  @@index([universityId, approvalStatus])
}

// ! University Supervisor Profile Model

model UniversitySupervisorProfile {
  userId       Int     @id
  universityId Int
  department   String?

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  university University? @relation(fields: [universityId], references: [id], onDelete: Cascade)
}

// ! Company Trainer Profile Model

model CompanyTrainerProfile {
  userId         Int     @id
  companyId      Int
  position       String?
  specialization String?

  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ! Training Opportunity Model

model TrainingOpportunity {
  id             Int          @id @default(autoincrement())
  companyId      Int
  title          String
  description    String
  requiredSkills String?
  duration       String?
  totalSeats     Int
  location       String?
  meetingLink    String?
  isActive       Boolean      @default(true)
  type           TrainingType @default(ONSITE)

  // internship  Internship? @relation("OppToInternship")
  internships Internship[]

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

// ! Internship Model

model Internship {
  id            Int              @id @default(autoincrement())
  opportunityId Int
  companyId     Int
  universityId  Int
  trainerId     Int?
  supervisorId  Int?
  status        InternshipStatus @default(ACTIVE)

  students    InternshipStudent[]
  attendance  Attendance[]
  evaluations Evaluation[]
  tasks       Task[]

  company     Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  university  University          @relation(fields: [universityId], references: [id], onDelete: Cascade)
  opportunity TrainingOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  trainer     User?               @relation("TrainerInternship", fields: [trainerId], references: [id], onDelete: SetNull)
  supervisor  User?               @relation("SupervisorInternship", fields: [supervisorId], references: [id], onDelete: SetNull)
  // opportunityId String @unique
  // opportunity   TrainingOpportunity @relation("OppToInternship", fields: [opportunityId], references: [id])

  @@index([companyId])
  @@index([universityId])
  @@index([status])
  @@index([universityId, status])
}

// ! Internship Student Model

model InternshipStudent {
  id           Int @id @default(autoincrement())
  internshipId Int
  studentId    Int
  createdAt    DateTime @default(now())

  internship Internship     @relation(fields: [internshipId], references: [id], onDelete: Cascade)
  student    StudentProfile @relation(fields: [studentId], references: [userId], onDelete: Cascade)

  @@unique([internshipId, studentId])
  @@index([studentId])
  @@index([internshipId])
}

// ! Task Model

model Task {
  id           Int        @id @default(autoincrement())
  internshipId Int
  title        String
  description  String?
  deadline     DateTime?
  status       TaskStatus @default(TODO)

  submissions TaskSubmission[]
  internship  Internship       @relation(fields: [internshipId], references: [id], onDelete: Cascade)

  @@index([internshipId])
  @@index([status])
}

// ! Task Submission Model

model TaskSubmission {
  id          Int      @id @default(autoincrement())
  taskId      Int
  studentId   Int
  fileUrl     String?
  score       Float?
  feedback    String?
  submittedAt DateTime @default(now())

  aiEvaluations AIEvaluation[]

  student StudentProfile @relation(fields: [studentId], references: [userId], onDelete: Cascade)
  task    Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([studentId])
  @@index([taskId, studentId])
}

// ! Attendance Model

model Attendance {
  id           Int              @id @default(autoincrement())
  internshipId Int
  studentId    Int
  date         DateTime
  status       AttendanceStatus

  internship Internship     @relation(fields: [internshipId], references: [id], onDelete: Cascade)
  student    StudentProfile @relation(fields: [studentId], references: [userId], onDelete: Cascade)

  @@index([internshipId])
  @@index([studentId])
  @@index([internshipId, date])
}

// ! Evaluation Model

model Evaluation {
  id           Int            @id @default(autoincrement())
  internshipId Int
  studentId    Int
  evaluatorId  Int
  type         EvaluationType
  score        Float?
  feedback     String?
  createdAt    DateTime       @default(now())

  evaluator  User           @relation("UserEvaluations", fields: [evaluatorId], references: [id], onDelete: Cascade)
  internship Internship     @relation(fields: [internshipId], references: [id], onDelete: Cascade)
  student    StudentProfile @relation(fields: [studentId], references: [userId], onDelete: Cascade)

  @@index([studentId])
  @@index([internshipId])
  @@index([evaluatorId])
}

// ! AI Evaluation Model

model AIEvaluation {
  id               Int      @id @default(autoincrement())
  taskSubmissionId Int
  score            Float?
  analysis         String?
  recommendations  String?
  createdAt        DateTime @default(now())

  taskSubmission TaskSubmission @relation(fields: [taskSubmissionId], references: [id], onDelete: Cascade)
}

// ! Message Model

model Message {
  id         Int      @id @default(autoincrement())
  senderId   Int
  receiverId Int
  content    String
  createdAt  DateTime @default(now())

  sender   User @relation("sent", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("recv", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([receiverId])
  @@index([senderId, receiverId])
}

// ! Notification Model

model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int
  title     String
  body      String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  type      NotificationType

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
}
